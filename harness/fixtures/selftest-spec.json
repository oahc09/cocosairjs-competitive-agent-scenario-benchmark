{
  "briefId": "SMOKE-SELFTEST",
  "briefVersion": "1.0.0",
  "frozen": true,
  "frozenAt": "2026-10-02T00:00:00Z",
  "title": "Harness self-test spec (smoke probes + one intentionally failing assertion + word-table coverage)",
  "goal": "验证 harness 本身:nonBlank/motion PASS、故意失败的断言被正确判 FAIL、ui/data-bench/key 动作词可用。",
  "domains": ["Lifecycle", "State"],
  "assets": [],
  "scaleAndPerformance": { "minFps": 30 },
  "completionContract": {
    "build": "npm run build 必须退出码 0",
    "ready": "window.__appReady === true(10s 内)",
    "state": "window.__bench = { getState(): object, reset(): void }",
    "noUncaughtErrors": true
  },
  "probes": [
    {
      "probeId": "P1",
      "precondition": "__appReady",
      "action": "wait:800",
      "waitMs": 0,
      "stateAssertion": { "jq": "$.ready == true && $.frame >= 1" },
      "visualAssertion": { "type": "nonBlank", "params": { "region": "full", "minLitPixelRatio": 0.03 } },
      "threshold": "非空渲染",
      "evidence": ["screenshot", "stateSample"]
    },
    {
      "probeId": "P2",
      "precondition": "P1 passed",
      "action": "wait:300",
      "waitMs": 0,
      "sampleWindowMs": 600,
      "stateAssertion": { "jq": "$.after.frame > $.before.frame" },
      "visualAssertion": { "type": "motion", "params": { "region": "center:80%", "minMotionPixelRatio": 0.005 } },
      "threshold": "帧递增 + 中央运动像素",
      "evidence": ["screenshot", "stateSample"]
    },
    {
      "probeId": "P3",
      "precondition": "P2 passed",
      "action": "wait:200",
      "waitMs": 0,
      "sampleWindowMs": 700,
      "stateAssertion": { "jq": "$.after.frame - $.before.frame >= 5" },
      "threshold": "frame 推进速率 >= 5 帧/700ms",
      "evidence": ["stateSample"]
    },
    {
      "probeId": "P4",
      "precondition": "P3 passed",
      "action": "click:ui=reset+wait:400",
      "waitMs": 0,
      "stateAssertion": { "jq": "$.resetCount >= 1 && $.frame < 120 && $.ready == true" },
      "visualAssertion": { "type": "nonBlank", "params": { "region": "full", "minLitPixelRatio": 0.03 } },
      "threshold": "reset 生效且画面不中断",
      "evidence": ["screenshot", "stateSample"]
    },
    {
      "probeId": "P5",
      "precondition": "P4 passed",
      "action": "wait:300",
      "waitMs": 0,
      "stateAssertion": { "jq": "$.frame > 99999" },
      "threshold": "故意失败的断言:必须被 harness 判为 FAIL(负向对照)",
      "evidence": ["stateSample"]
    },
    {
      "probeId": "P6",
      "precondition": "P5 passed",
      "action": "click:ui=ping+wait:200",
      "waitMs": 0,
      "stateAssertion": { "jq": "$.pingCount >= 1" },
      "threshold": "data-bench=ping 控件可点击(前置失败,本探针应 SKIPPED)",
      "evidence": ["stateSample"]
    },
    {
      "probeId": "P7",
      "precondition": "P4 passed",
      "action": "key:b+wait:200",
      "waitMs": 0,
      "stateAssertion": { "jq": "$.keyCount >= 1" },
      "threshold": "key 动作词触发页面 keydown",
      "evidence": ["stateSample"]
    }
  ],
  "scoring": {
    "behaviorItems": [
      "非空渲染",
      "运动 + frame 递增",
      "reset 生效",
      "ui/data-bench/key 动作词可用"
    ]
  }
}
