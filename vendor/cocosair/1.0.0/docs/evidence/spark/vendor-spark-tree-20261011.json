    "cd \"$REPO\" && node tools/build/vendor-spark-tree.cjs --manifest docs/evidence/spark/vendor-spark-tree-20261011.json",
    "cd \"$REPO/vendor/spark\" && { find src rust -type f; printf '%s\\n' LICENSE package.json CHANGELOG.md README.md tsconfig.json; } | LC_ALL=C sort | while IFS= read -r f; do sha256sum \"$f\"; done",
    "cd \"$SPARK_UPSTREAM\" && { find src rust -type f; printf '%s\\n' LICENSE package.json CHANGELOG.md README.md tsconfig.json; } | LC_ALL=C sort | while IFS= read -r f; do sha256sum \"$f\"; done",
    "diff <(cd \"$REPO/vendor/spark\" && { find src rust -type f; printf '%s\\n' LICENSE package.json CHANGELOG.md README.md tsconfig.json; } | LC_ALL=C sort | while IFS= read -r f; do sha256sum \"$f\"; done) <(cd \"$SPARK_UPSTREAM\" && { find src rust -type f; printf '%s\\n' LICENSE package.json CHANGELOG.md README.md tsconfig.json; } | LC_ALL=C sort | while IFS= read -r f; do sha256sum \"$f\"; done)",
    "cd \"$REPO/vendor/spark\" && { find src rust -type f; printf '%s\\n' LICENSE package.json CHANGELOG.md README.md tsconfig.json; } | LC_ALL=C sort | while IFS= read -r f; do sha256sum \"$f\"; done | sed 's|^\\([0-9a-f]\\{64\\}\\) \\*|\\1  |' | sha256sum",
    "cmp \"$REPO/vendor/spark\"/LICENSE \"$REPO/licenses/LICENSE_spark.txt\" && cmp \"$REPO/licenses/LICENSE_spark.txt\" \"$SPARK_UPSTREAM/LICENSE\""
