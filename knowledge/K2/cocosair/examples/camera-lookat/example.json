  "learning": {
    "goal": "理解相机瞄准目标的数学：由方向向量求 pitch/yaw 欧拉角并施加 setRotationFromEuler",
    "points": [
      "相机默认朝向 -Z 的欧拉角语义",
      "pitch = atan2(dy, len(dxz))，yaw = atan2(-dx, -dz)",
      "点击切换目标后相机朝向即时变化"
    ]
  },
  "effect": {
    "functional": "相机初始瞄准 TargetLeft；点击后用 aimAt 重算欧拉角瞄准 TargetRight；cameraNode.eulerAngles 随目标切换改变。",
    "visual": "初始画面以蓝色球为中心，点击后取景中心跳到橙色球，相机角度切换干脆无插值"
  },
